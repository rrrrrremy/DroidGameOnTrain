rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /daily_scores/{doc} {
      // Single-document reads are harmless; list queries must carry a limit
      // so nobody can pull (or make the app pull) the whole collection.
      allow get: if true;
      allow list: if request.query.limit <= 200;

      // Create-only, exactly the fields the game writes, every one bounded.
      // percent is clamped because the leaderboard sorts by it - without the
      // clamp anyone could insert percent: 9999 and own the top row.
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'score', 'maxScore', 'percent', 'date', 'shape', 'createdAt'])
        && request.resource.data.keys().hasAll(
          ['name', 'score', 'maxScore', 'percent', 'date', 'shape', 'createdAt'])
        // Exactly two uppercase letters. The client restricts the field as
        // you type, but the client is not the boundary - anyone can address
        // Firestore directly, so "users cannot submit free text" is only
        // true if it is true here.
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z][A-Z]$')
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 30
        && request.resource.data.maxScore is number
        && request.resource.data.maxScore > 0
        && request.resource.data.maxScore <= 30
        && request.resource.data.percent is number
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.shape is string
        && request.resource.data.shape.size() <= 20
        // serverTimestamp() resolves to request.time; a hand-written
        // timestamp that doesn't match is rejected.
        && request.resource.data.createdAt == request.time;
    }
  }
}
